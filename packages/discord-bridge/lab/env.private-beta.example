# Copy to lab/.env and chmod 0600. Never commit the real file.
# Values are never printed by the operator script (SET/MISSING only).
D1_RUNTIME_MODE=private-beta
D1_DISCORD_TOKEN_SLOT_0=
D1_DISCORD_TOKEN_SLOT_1=
D1_DISCORD_TOKEN_SLOT_2=
D1_DISCORD_TOKEN_SLOT_3=
D1_DISCORD_TOKEN_SLOT_4=
D1_DISCORD_TOKEN_OVERFLOW=
D1_DISCORD_GUILD_ID=
D1_DISCORD_CHANNEL_ID=
D1_TS_HOST=d1-ts6-lab
D1_TS_PORT=9987
# Optional:
# D1_TS_CHANNEL=
# D1_TS_PASSWORD=
# Phase 1 (supervised, no in-process reconnects):
# D1_DAVE_SINGLE_ATTEMPT=1
# Phase 2 (bounded recovery, 3 per 60s). Leave unset. Compose still uses restart: "no".
