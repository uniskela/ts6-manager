# TS6 Manager native media sidecar settings.
# Copy to sidecar.env, edit, and keep it readable only by the account that
# runs the sidecar: it holds a secret. One KEY=value per line, no quotes and
# no spaces around "=". Every variable is described in
# docs/public/environment-variables.md.

# Required. The same value as SIDECAR_SECRET in the backend's environment.
# Generate one with: openssl rand -base64 32
SIDECAR_SECRET=

# HTTP API. Listen only on the address the backend reaches. Use 127.0.0.1
# when the backend runs on this machine outside Docker. A backend in Docker
# or on another machine needs a private LAN or Tailscale address here, plus a
# firewall rule that admits only the backend. Leaving SIDECAR_HOST empty
# listens on every interface.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=9800

# WebRTC media. Viewers connect to this UDP port on the advertised IPv4
# address(es), so both must be reachable from TeamSpeak clients and browsers.
WEBRTC_UDP_PORT=10000
WEBRTC_NAT1TO1_IP=

# FFmpeg with the hardware encoders this host should use. Give full paths:
# background services do not inherit your shell's PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# The same media files the backend sees under its own MUSIC_DIR.
MUSIC_DIR=

# Linux VAAPI only: render node, when it is not /dev/dri/renderD128.
#VAAPI_DEVICE=/dev/dri/renderD128
