# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./data/ts6webui.db"
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
# Separate AES key for stored credentials (required in production). Generate once and keep unchanged across restarts/upgrades.
ENCRYPTION_KEY=change-this-to-another-random-string-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=http://localhost:5173

# Video sidecar (required when using SIDECAR_URL in production)
SIDECAR_URL=
SIDECAR_SECRET=change-this-to-a-sidecar-shared-secret
SIDECAR_BINARY_PATH=

# Optional
TS_ALLOW_SELF_SIGNED=false
YT_COOKIE_FILE=
MUSIC_DIR=

# Frontend (Vite env vars)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# TeamSpeak beta13 settings belong on the TeamSpeak container, not this manager.
# Recommended there: TSSERVER_QUERY_HTTP_ALLOW_GUEST=0 and TSSERVER_QUERY_SSH_ALLOW_GUEST=0.
# Provision a stable TSSERVER_QUERY_ADMIN_API_KEY there; enter it in the encrypted
# manager connection form. Changing it requires updating that saved connection key.
# See README: TeamSpeak compatibility and beta13 setup.
