# Copy to .env.accept-staging (gitignored if named .env.accept-staging — keep out of commits).
#   cp .env.accept-staging.example .env.accept-staging
# Generate secrets on the operator host (do not reuse production values):
#   openssl rand -hex 32   # JWT_SECRET, ENCRYPTION_KEY, SIDECAR_SECRET, query password/key

JWT_SECRET=
ENCRYPTION_KEY=
SIDECAR_SECRET=

# TeamSpeak ServerQuery for the bundled lab server only (bootstrap + health).
# Not published on the host — backend reaches teamspeak:10022 on the compose network.
TS_ACCEPT_QUERY_PASSWORD=
TS_ACCEPT_QUERY_API_KEY=

# Private HTTPS origin that reaches 127.0.0.1:ACCEPT_HTTP_PORT (Tailscale Serve, etc.).
# Production-mode backend rejects plain http:// for !remote.
PUBLIC_URL=https://example.ts.net

# Loopback admin UI / Serve target (default 13100 — avoids pr-test :3000 and beta :13000).
ACCEPT_HTTP_PORT=13100

# TeamSpeak voice: bind to ONE private interface IPv4 (Tailscale or lab LAN).
# Never 0.0.0.0. Never a production TS address.
# Clients connect to TS_VOICE_BIND_IP:TS_VOICE_HOST_PORT (maps to container 9987/udp).
TS_VOICE_BIND_IP=
TS_VOICE_HOST_PORT=19987

# Optional WebRTC preview (loopback only in accept-staging compose).
WEBRTC_UDP_PORT=10000

TS_ALLOW_PRIVATE_HOSTS=true
TS_ALLOW_SELF_SIGNED=true
