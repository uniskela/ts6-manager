# Discord Phase 2C Step 4B — isolated integration test template.
# Copy to a gitignored local file (e.g. .env.discord-integration-test) and fill values.
# Never commit real tokens, public keys, or bot secrets.
# Keep DISCORD_INTERACTIONS_ENABLED=false until a supervised live test is approved.

NODE_ENV=development
PORT=3011

# Temporary SQLite only — basename MUST be exactly discord-int-test.db
# (substring markers / query-string tricks are rejected).
DATABASE_URL="file:./data/discord-int-test.db"

JWT_SECRET=replace-with-local-dev-secret-at-least-32-chars
ENCRYPTION_KEY=replace-with-local-dev-encryption-key-32ch

# Dedicated TEST Discord application (preferred). Do not reuse the D1 voice-bridge app.
# Do not point this at a production Interactions URL until approved.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Registration-only; never logged by readiness/bind CLIs.
DISCORD_BOT_TOKEN=

# Must match DiscordGuildBinding.instanceId for the test binding.
DISCORD_INSTANCE_ID=discord-int-test

# Comma-separated Discord role snowflakes in the TEST guild.
DISCORD_VIEWER_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=

# Stay false for preparation. Enable only during a supervised live window.
DISCORD_INTERACTIONS_ENABLED=false

# Optional labels for operator notes (not read by the backend).
# DISCORD_TEST_GUILD_ID=
# DISCORD_TEST_MUSIC_BOT_ID=
# DISCORD_TEST_SERVER_CONFIG_ID=
