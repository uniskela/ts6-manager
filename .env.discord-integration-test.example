# Discord Phase 2C Step 4B — isolated integration test template.
# Copy to a gitignored local file (e.g. .env.discord-integration-test) and fill values.
# Never commit real tokens, public keys, or bot secrets.
# Keep DISCORD_INTERACTIONS_ENABLED=false until a supervised live test is approved.

NODE_ENV=development
PORT=3011
# Bind localhost only for Stage A (required when TS6_ISOLATED_INTEGRATION=1).
LISTEN_HOST=127.0.0.1
# Local writable music dir (default /data/music is not usable on this host).
# MUSIC_DIR=/absolute/path/to/packages/backend/data/discord-int-music

# Fail-closed isolated backend: refuses ts6webui.db and non-loopback binds.
TS6_ISOLATED_INTEGRATION=1
# Second latch for a supervised live-interactions window (default off).
# Requires DISCORD_TEST_APPLICATION_ID == DISCORD_APPLICATION_ID and a valid public key.
# TS6_ISOLATED_LIVE_INTERACTIONS=0
# DISCORD_TEST_APPLICATION_ID=
# Optional: refuse if APPLICATION_ID equals this production identity.
# DISCORD_PRODUCTION_APPLICATION_ID=


# Temporary SQLite only — basename MUST be exactly discord-int-test.db.
# Prefer an absolute file: URL so Prisma schema-dir and CLI cwd agree, e.g.:
# DATABASE_URL="file:/absolute/path/to/packages/backend/prisma/data/discord-int-test.db"
DATABASE_URL="file:./data/discord-int-test.db"

JWT_SECRET=replace-with-local-dev-secret-at-least-32-chars
ENCRYPTION_KEY=replace-with-local-dev-encryption-key-32ch

# Dedicated TEST Discord application (preferred). Do not reuse the D1 voice-bridge app.
# Do not point this at a production Interactions URL until approved.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Registration-only; never logged by readiness/bind CLIs.
DISCORD_BOT_TOKEN=

# Must match DiscordGuildBinding.instanceId for the test binding.
DISCORD_INSTANCE_ID=discord-int-test

# Comma-separated Discord role snowflakes in the TEST guild.
# Viewer-only identity for #5/#21: a guild member that has VIEWER and does NOT have ADMIN.
# Do not put the same snowflake in both lists. Do not grant Manage Guild / admin just to pass.
DISCORD_VIEWER_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=

# Stay false for preparation. Enable only during a supervised live window.
DISCORD_INTERACTIONS_ENABLED=false

# Private TEST guild snowflake (required before Stage A).
# DISCORD_TEST_GUILD_ID=
# DISCORD_TEST_MUSIC_BOT_ID=
# DISCORD_TEST_SERVER_CONFIG_ID=

# Optional: isolated INT-TEST media fetcher for /radio play (finding #20).
# Use docker-compose.discord-int-media-fetcher.yml only — never production fetcher services.
# Rootless: do not bind-mount jobs.sock/.token to a host backend (EACCES). Prefer
# --profile int-backend so the INT backend container mounts named volume /jobs.
# Seed (MEDIA_FETCHER_SEED_TOKEN_FILE) ≠ installed token (/jobs/.token in containers).
# Without MEDIA_FETCHER=1 + reachable /jobs, /radio play returns RADIO_FETCHER_UNAVAILABLE
# (not a PASS for #20). Offline check: ./scripts/discord-int-media-fetcher-ipc-check.sh
# MEDIA_FETCHER=1
# MEDIA_FETCHER_SOCK=/jobs/jobs.sock
# MEDIA_FETCHER_TOKEN_FILE=/jobs/.token
# YT_DLP_PATH=yt-dlp
# SIDECAR_SECRET=replace-with-local-dev-sidecar-secret-at-least-16
# DISCORD_INT_DB_DIR=/absolute/path/to/packages/backend/prisma/data
# DISCORD_INT_MUSIC_DIR=/absolute/path/to/packages/backend/data/discord-int-music
