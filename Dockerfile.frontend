FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy everything at once to avoid BuildKit ordering bug on Windows
FROM base AS build
ARG GIT_SHA=
ENV VITE_GIT_SHA=$GIT_SHA
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/frontend run build

# Production: serve with nginx
FROM nginx:alpine-slim AS production

# The full nginx:alpine image includes the unused image-filter module and
# libtiff dependency (CVE-2026-4775). The official slim image only installs
# nginx and the runtime dependencies needed by this static SPA / API proxy.
# Upgrade all installed Alpine packages for available security fixes.
RUN apk upgrade --no-cache

COPY --from=build /app/packages/frontend/dist /usr/share/nginx/html

# SPA routing, network-only API proxying and PWA update headers
COPY docker-commands/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
