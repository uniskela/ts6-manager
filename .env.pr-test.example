# Copy to .env before running docker-compose.pr-test.yml
#   cp .env.pr-test.example .env

JWT_SECRET=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
SIDECAR_SECRET=replace-with-openssl-rand-base64-32

# Optional: shown in the UI footer when built via compose
# GIT_SHA=pr-test

# Connection testing from containers to a TS server on your host
TS_ALLOW_PRIVATE_HOSTS=true
TS_ALLOW_SELF_SIGNED=true

# TeamSpeak 6 server bundled in docker-compose.pr-test.yml (query / serveradmin password)
TS_PR_TEST_ADMIN_PASSWORD=testadmin

# Wizard defaults when using the bundled TeamSpeak service:
#   Host: teamspeak
#   WebQuery port: 10080
#   SSH port: 10022
#   SSH user: serveradmin
#   SSH password: same as TS_PR_TEST_ADMIN_PASSWORD

# Generate secrets:
#   echo "JWT_SECRET=$(openssl rand -base64 32)" >> .env
#   echo "ENCRYPTION_KEY=$(openssl rand -base64 32)" >> .env
#   echo "SIDECAR_SECRET=$(openssl rand -base64 32)" >> .env
