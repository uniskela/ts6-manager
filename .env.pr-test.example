# Copy to .env before running docker-compose.pr-test.yml
#   cp .env.pr-test.example .env
#
# Local-only defaults below are fine for a disposable pr-test stack.
# Do not reuse these values in production / Coolify / GHCR compose.

JWT_SECRET=local-pr-test-jwt-secret-change-me-not-for-prod
ENCRYPTION_KEY=local-pr-test-encryption-key-change-me-not-for-prod
SIDECAR_SECRET=local-pr-test-sidecar-secret-change-me-not-for-prod

# Optional: shown in the UI footer when built via compose
# GIT_SHA=pr-test

# Connection testing from containers to a TS server on your host / compose network
TS_ALLOW_PRIVATE_HOSTS=true
TS_ALLOW_SELF_SIGNED=true

# TeamSpeak 6 (beta13) bundled in docker-compose.pr-test.yml
TS_PR_TEST_ADMIN_PASSWORD=testadmin
TS_PR_TEST_API_KEY=local-pr-test-webquery-api-key-not-for-prod

# Gated backend seed of the bundled connection (omit or set 0 to disable)
LOCAL_DEV_BOOTSTRAP_CONNECTION=1
TS_BOOTSTRAP_HOST=teamspeak
TS_BOOTSTRAP_WEBQUERY_PORT=10080
TS_BOOTSTRAP_NAME=Local TeamSpeak 6
TS_BOOTSTRAP_SSH_PORT=10022
TS_BOOTSTRAP_SSH_USER=serveradmin
# TS_BOOTSTRAP_API_KEY / SSH password are taken from TS_PR_TEST_* via compose

# After up --build:
#   http://localhost:3000/setup  → create admin (no default admin user)
#   Connections already lists host teamspeak (WebQuery 10080 + SSH Query 10022)
# Demo mode remains available separately and is not replaced by this seed.
