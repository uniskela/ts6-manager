# Copy to .env before running docker-compose.pr-test.yml or
# docker-compose.pr-test.windows-amf.yml (native Windows sidecar).
#   cp .env.pr-test.example .env
#
# Local-only defaults below are fine for a disposable pr-test stack.
# Do not reuse these values in production / Coolify / GHCR compose.

JWT_SECRET=local-pr-test-jwt-secret-change-me-not-for-prod
ENCRYPTION_KEY=local-pr-test-encryption-key-change-me-not-for-prod
SIDECAR_SECRET=local-pr-test-sidecar-secret-change-me-not-for-prod

# Optional: shown in the UI footer when built via compose
# GIT_SHA=pr-test

# Connection testing from containers to a TS server on your host / compose network
TS_ALLOW_PRIVATE_HOSTS=true
TS_ALLOW_SELF_SIGNED=true

# TeamSpeak 6 (beta13) bundled in docker-compose.pr-test.yml
TS_PR_TEST_ADMIN_PASSWORD=testadmin
TS_PR_TEST_API_KEY=local-pr-test-webquery-api-key-not-for-prod

# Gated backend seed of the bundled connection (omit or set 0 to disable)
LOCAL_DEV_BOOTSTRAP_CONNECTION=1
TS_BOOTSTRAP_HOST=teamspeak
TS_BOOTSTRAP_WEBQUERY_PORT=10080
TS_BOOTSTRAP_NAME=Local TeamSpeak 6
TS_BOOTSTRAP_SSH_PORT=10022
TS_BOOTSTRAP_SSH_USER=serveradmin
# TS_BOOTSTRAP_API_KEY / SSH password are taken from TS_PR_TEST_* via compose

# After up --build:
#   http://localhost:3000/setup  → create admin (no default admin user)
#   Connections already lists host teamspeak (WebQuery 10080 + SSH Query 10022)
#   TeamSpeak metrics listen on http://localhost:9187/metrics (and teamspeak:9187
#   on the compose network). Bootstrap seed does not set metricsEnabled — turn
#   that on in Settings → Connections when testing manager-side scrapes.
# Demo mode remains available separately and is not replaced by this seed.
#
# Browser video preview (WebRTC media UDP — not the sidecar HTTP :9800):
# WEBRTC_UDP_PORT=10000
# WEBRTC_BIND_IP=127.0.0.1
# WEBRTC_NAT1TO1_IP=127.0.0.1
# For a browser on another machine, set WEBRTC_BIND_IP and WEBRTC_NAT1TO1_IP to
# the same Docker-host LAN or Tailscale IPv4 (UDP must be reachable there).
#
# Watching the stream in the TeamSpeak client uses the same UDP port, but the
# TeamSpeak client does not connect to 127.0.0.1, even on this host: it stays at
# "Connecting...". Also advertise the Docker host's LAN IPv4 and publish there:
# WEBRTC_BIND_IP=0.0.0.0
# WEBRTC_NAT1TO1_IP=127.0.0.1,192.168.1.20
#
# Windows AMF: run docker-compose.pr-test.windows-amf.yml alone, after starting
# the native sidecar (PowerShell commands in docs/video-streaming.md).
# Docker backend uses http://host.docker.internal:9800 and shares
# ./.pr-test/music:/data/music. Set the native sidecar MUSIC_DIR to that same
# repository directory on Windows; never pass /data/music to native FFmpeg.
# SIDECAR_SECRET above must match the native sidecar's environment.
# WEBRTC_UDP_PORT / WEBRTC_NAT1TO1_IP must be set in the native process;
# Compose does not forward this .env file to it. WEBRTC_BIND_IP is Docker-only
# and has no effect on the native sidecar. Do not start a Docker sidecar or
# publish UDP 10000 in this topology. All published Docker ports use loopback.
