# Single image: nginx (SPA + API proxy) + Node backend + Go sidecar
# Adapted from upstream PR #64 by @joaobosconff (clusterzx/ts6-manager)

FROM golang:1.26-bookworm AS sidecar-build
WORKDIR /src
COPY packages/sidecar/go.mod packages/sidecar/go.sum ./
RUN go mod download
COPY packages/sidecar/*.go ./
# The backend compares this with its own version (docs/public/native-sidecar.md).
COPY version.txt /tmp/version.txt
RUN CGO_ENABLED=0 go build \
      -ldflags="-s -w -X main.version=$(tr -d '[:space:]' < /tmp/version.txt)" \
      -o /sidecar .

FROM node:20-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl python3 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG GIT_SHA=
ENV VITE_GIT_SHA=$GIT_SHA
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build
RUN pnpm --filter @ts6/frontend run build
RUN pnpm --filter @ts6/backend --prod deploy /prod/backend && \
    test -f /prod/backend/assets/default-bot-avatar.png && \
    test -f /prod/backend/dist/index.js && \
    test -f /prod/backend/generated/prisma/index.js && \
    test -f /prod/backend/node_modules/prisma/build/index.js && \
    test -f /prod/backend/prisma.config.mjs && \
    test -f /prod/backend/node_modules/@ts6/common/dist/index.js

FROM node:20-slim AS production
ARG GIT_SHA=
COPY .yt-dlp-version /tmp/yt-dlp-version
COPY .deno-version /tmp/deno-version
COPY docker-commands/install-deno.sh /tmp/install-deno.sh
ENV NODE_ENV=production \
    SIDECAR_URL=http://127.0.0.1:9800 \
    DATABASE_URL=file:/app/packages/backend/data/ts6webui.db \
    GIT_SHA=$GIT_SHA

# mesa-va-drivers (all arches) and intel-media-va-driver (amd64) back optional
# VAAPI encoders when /dev/dri is passed through; software encoding does not need them.
RUN apt-get update && \
    apt-get upgrade -y && \
    VAAPI_PACKAGES="mesa-va-drivers" && \
    if [ "$(dpkg --print-architecture)" = "amd64" ]; then VAAPI_PACKAGES="$VAAPI_PACKAGES intel-media-va-driver"; fi && \
    apt-get install -y --no-install-recommends \
      $VAAPI_PACKAGES \
      openssl \
      ffmpeg \
      python3 \
      python3-pip \
      ca-certificates \
      nginx \
      supervisor \
      netcat-openbsd \
      curl \
      unzip \
    && YT_DLP_VERSION="$(tr -d '[:space:]' < /tmp/yt-dlp-version)" \
    && test -n "$YT_DLP_VERSION" \
    && python3 -m pip install --break-system-packages --no-cache-dir "yt-dlp[default]==${YT_DLP_VERSION}" \
    && test "$(yt-dlp --version)" = "$YT_DLP_VERSION" \
    && rm -f /tmp/yt-dlp-version \
    && sed -i 's/\r$//' /tmp/install-deno.sh \
    && chmod +x /tmp/install-deno.sh \
    && /tmp/install-deno.sh \
    && rm -f /tmp/install-deno.sh \
    && rm -rf /usr/local/lib/node_modules/npm \
              /usr/local/lib/node_modules/corepack \
              /root/.cache/node/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
             /usr/local/bin/pnpm /usr/local/bin/pnpx \
    && yt-dlp --version \
    && ffmpeg -version \
    && node --version \
    && deno --version \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /prod/backend ./packages/backend
COPY --from=build /app/packages/frontend/dist /var/www/html
COPY --from=sidecar-build /sidecar /usr/local/bin/sidecar

# Install site config where Debian nginx always loads it (conf.d), and drop the stock default site.
COPY docker-commands/nginx-all-in-one.conf /etc/nginx/conf.d/ts6.conf
RUN rm -f /etc/nginx/sites-enabled/default

COPY docker-commands/supervisord-all-in-one.conf /etc/supervisor/conf.d/ts6.conf
COPY docker-commands/apply-schema.sh /usr/local/bin/apply-schema.sh
COPY docker-commands/start-backend.sh /usr/local/bin/start-backend.sh
RUN sed -i 's/\r$//' /usr/local/bin/apply-schema.sh \
      /usr/local/bin/start-backend.sh \
 && chmod +x /usr/local/bin/apply-schema.sh \
      /usr/local/bin/start-backend.sh \
      /usr/local/bin/sidecar \
 && mkdir -p /app/packages/backend/data /data/music /root/.config/yt-dlp \
 && printf '%s\n' '--js-runtimes deno' > /root/.config/yt-dlp/config

# Only publish nginx (:80) from compose. Backend/sidecar stay loopback-only inside the container.
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD curl -fsS http://127.0.0.1/api/health >/dev/null && curl -fsS http://127.0.0.1:9800/health >/dev/null || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/ts6.conf"]
